# Database (Railway PostgreSQL plugin will automatically provide this)
DATABASE_URL=postgresql://postgres:password@host:5432/railway

# Public App URL (Your Railway service public domain, e.g. https://your-app.up.railway.app)
NEXT_PUBLIC_APP_URL=https://your-app.up.railway.app

# AI Engine Configuration (OpenAI or any OpenAI-compatible API)
AI_API_KEY=your_openai_or_groq_or_gemini_key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_FALLBACK_MODELS=gpt-3.5-turbo

# Telegram Bot (Optional - for Telegram channel)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
USE_TELEGRAM_TESTING=true

# Demo Business Slug (Optional)
DEMO_BUSINESS_SLUG=demo-store

